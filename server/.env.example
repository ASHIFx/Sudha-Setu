# Copy to .env and fill in real values. Never commit .env.
NODE_ENV=development
PORT=5000

# MongoDB connection string
MONGO_URI=mongodb://127.0.0.1:27017/sudha_setu

# Comma-separated list of allowed browser origins (no trailing slash)
CLIENT_ORIGINS=http://localhost:5173,http://localhost:3000

# Token signing key. Must be at least 32 characters; the server refuses to
# boot otherwise. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
